---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const date = post.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <p class="label">{date}{post.data.tags.length > 0 && ` · ${post.data.tags.join(" · ")}`}</p>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.description}</p>
    {post.data.experiment && (
      <p class="run">
        <a href={`${base}/experiments/${post.data.experiment}`}>Open the experiment →</a>
      </p>
    )}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  h1 { font-size: clamp(30px, 5.5vw, 44px); line-height: 1.08; letter-spacing: -0.02em; margin: 8px 0 12px; text-wrap: balance; }
  .lede { font-family: var(--f-read); font-size: 21px; line-height: 1.4; color: var(--muted); margin: 0 0 20px; text-wrap: pretty; }
  .run a {
    display: inline-block; font-weight: 600; font-size: 14px; text-decoration: none;
    background: var(--accent-soft); padding: 8px 12px; border-radius: 6px;
  }
  .prose { font-family: var(--f-read); font-size: 19px; line-height: 1.6; margin-top: 32px; }
  .prose :global(h2) { font-family: var(--f-ui); font-size: 22px; letter-spacing: -0.01em; margin: 48px 0 8px; }
  .prose :global(h3) { font-family: var(--f-ui); font-size: 17px; margin: 32px 0 4px; }
  .prose :global(p), .prose :global(li) { text-wrap: pretty; }
  .prose :global(blockquote) { margin: 24px 0; padding-left: 16px; border-left: 3px solid var(--accent); color: var(--fg); font-style: italic; }
  .prose :global(code) { font-family: var(--f-mono); font-size: 0.8em; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 1px 4px; }
  .prose :global(.table) { overflow-x: auto; margin: 24px 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-family: var(--f-ui); font-size: 14px; line-height: 1.45; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); }
  .prose :global(th) { font-family: var(--f-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .prose :global(iframe) { width: 100%; height: 640px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
  .prose :global(.caption) { font-family: var(--f-ui); font-size: 13px; color: var(--muted); margin-top: 6px; }
  .prose :global(.sources) { font-family: var(--f-ui); font-size: 14px; }
</style>
